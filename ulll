@startuml
autonumber

actor Студент
participant Клиент
participant Контроллер
participant "Сервис авторизации" as Auth
participant "Сервис расписания" as Sched
participant "Сервис заданий" as Task
database БД
participant Хранилище
participant "Сервис проверки" as Check
participant "Система уведомлений" as Notify

Студент -> Клиент: Запустить экзамен()
Клиент -> Контроллер: запросНачала()

Контроллер -> Auth: проверитьЛичность()
Auth --> Контроллер: результат

Контроллер -> Sched: проверитьВремя()
Sched --> Контроллер: результат

alt Проверки не пройдены
    Контроллер --> Клиент: отклонить()
else Проверки пройдены
    Контроллер -> Task: выбратьВариант()
    Task -> БД: получитьВариант()
    БД --> Task: задание
    Task --> Контроллер: заданиеВыбрано
    
    Контроллер -> БД: создатьПопытку()
    БД --> Контроллер: попыткаСоздана
    
    Контроллер --> Клиент: вернутьЗадание()
end

loop Пока идет экзамен
    Клиент -> Хранилище: сохранитьДанные()
    Хранилище --> Клиент: сохранено
end

Студент -> Клиент: Сдать экзамен()
Клиент -> Контроллер: отправитьФайлы()

Контроллер -> Check: проверитьФайлы()
Check --> Контроллер: результат

alt Файлов не хватает и время есть
    Контроллер --> Клиент: вернутьКРаботе()
else Файлы в порядке или время вышло
    Контроллер -> БД: зафиксироватьРезультат()
    БД --> Контроллер: зафиксировано
    
    Контроллер -> Notify: уведомитьПреподавателя()
    Notify --> Контроллер: отправлено
    
    Контроллер --> Клиент: экзаменЗавершен()
end

@enduml
